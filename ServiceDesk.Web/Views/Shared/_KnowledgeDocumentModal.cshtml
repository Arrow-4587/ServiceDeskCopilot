<!-- Enterprise Knowledge Document Right-Side Slide-Out Drawer -->
<div id="kbDrawerBackdrop" class="kb-drawer-backdrop"></div>

<div id="kbDocumentDrawer" class="kb-drawer" role="dialog" aria-labelledby="kbDrawerTitle" aria-hidden="true">
    <!-- Drawer Header -->
    <div class="kb-drawer-header">
        <div class="min-w-0 flex-grow-1 me-3">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <span id="kbDrawerSection" class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill" style="font-size:0.75rem;">
                    General
                </span>
                <span id="kbDrawerVersion" class="badge bg-secondary-subtle text-secondary rounded-pill" style="font-size:0.75rem;">
                    v1.0
                </span>
                <span id="kbDrawerStatus" class="badge bg-success-subtle text-success border border-success-subtle rounded-pill" style="font-size:0.75rem;">
                    <i class="bi bi-check-circle-fill me-1"></i> Approved &amp; Active
                </span>
            </div>
            <h4 class="fw-bold mb-1 text-truncate" id="kbDrawerTitle" style="color:var(--text-heading);letter-spacing:-0.3px;font-size:1.25rem;">
                Document Details
            </h4>
            <div class="text-muted small">
                <i class="bi bi-clock me-1"></i>Last Updated: <span id="kbDrawerUpdated">—</span>
            </div>
        </div>

        <button type="button" id="kbDrawerBtnClose" class="btn-close" aria-label="Close Drawer"></button>
    </div>

    <!-- Drawer Body -->
    <div class="kb-drawer-body">
        <!-- Loading State -->
        <div id="kbDrawerSpinner" class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width:2.5rem;height:2.5rem;"></div>
            <p class="text-muted mt-3 mb-0 fw-semibold small">Fetching content from Azure Blob Storage...</p>
        </div>

        <!-- Error State -->
        <div id="kbDrawerError" class="alert alert-danger glass-card rounded-3 p-3" style="display:none;" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-octagon-fill fs-3 text-danger"></i>
                <div>
                    <h6 class="fw-bold mb-1">Failed to Load Document</h6>
                    <span id="kbDrawerErrorMessage" class="small">The document could not be retrieved from Azure Blob Storage.</span>
                </div>
            </div>
        </div>

        <!-- Document Content Container -->
        <div id="kbDrawerContent" class="markdown-body" style="display:none;color:var(--text-body);font-size:0.92rem;line-height:1.65;">
        </div>
    </div>

    <!-- Drawer Footer -->
    <div class="kb-drawer-footer">
        <span class="text-muted small">
            <i class="bi bi-shield-check text-success me-1"></i> Grounded Azure Artifact
        </span>
        <div class="d-flex align-items-center gap-2">
            <button type="button" id="kbDrawerBtnCopy" class="btn btn-sm btn-outline-secondary rounded-3 px-3 py-1.5 fw-semibold" title="Copy document content">
                <i class="bi bi-clipboard me-1"></i> <span id="kbDrawerCopyText">Copy</span>
            </button>
            <button type="button" id="kbDrawerBtnPrint" class="btn btn-sm btn-outline-secondary rounded-3 px-3 py-1.5 fw-semibold" title="Print document">
                <i class="bi bi-printer me-1"></i> Print
            </button>
            <button type="button" id="kbDrawerBtnCloseFooter" class="btn btn-sm btn-secondary rounded-3 px-3 fw-semibold">
                Close
            </button>
        </div>
    </div>
</div>
