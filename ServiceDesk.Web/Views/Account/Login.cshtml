@model ServiceDesk.Web.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "Enterprise IT Command Center - Sign In";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-lg">
                <div class="card-header bg-dark text-white text-center py-4">
                    <h3 class="font-weight-light my-1"><i class="bi bi-shield-lock-fill me-2"></i>Enterprise IT Command Center</h3>
                    <p class="mb-0 text-muted small">Authenticated Service Desk Copilot Identity</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Login" method="post">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control" id="emailInput" placeholder="name@company.com" />
                            <label for="emailInput">Corporate Email Address</label>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 mb-4">
                            <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-box-arrow-in-right me-2"></i>Sign In</button>
                        </div>
                    </form>

                    <hr class="my-4" />

                    <h6 class="text-muted text-center mb-3">Quick Login (Development Personas)</h6>
                    <div class="row g-2">
                        <div class="col-6">
                            <button type="button" class="btn btn-outline-secondary w-100 text-start btn-sm" onclick="setAccount('employee@company.com')">
                                <strong>Employee</strong><br/><small class="text-muted">employee@company.com</small>
                            </button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn btn-outline-info w-100 text-start btn-sm" onclick="setAccount('analyst@company.com')">
                                <strong>Analyst</strong><br/><small class="text-muted">analyst@company.com</small>
                            </button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn btn-outline-warning w-100 text-start btn-sm" onclick="setAccount('manager@company.com')">
                                <strong>Manager</strong><br/><small class="text-muted">manager@company.com</small>
                            </button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn btn-outline-danger w-100 text-start btn-sm" onclick="setAccount('admin@company.com')">
                                <strong>Administrator</strong><br/><small class="text-muted">admin@company.com</small>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function setAccount(email) {
            document.getElementById('emailInput').value = email;
        }
    </script>
}
