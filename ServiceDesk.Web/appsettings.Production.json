{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_PRODUCTION_DB_CONNECTION_STRING_HERE"
  },
  "AzureOpenAI": {
    "Endpoint": "YOUR_AZURE_OPENAI_ENDPOINT_HERE",
    "DeploymentName": "gpt-5-mini",
    "EmbeddingDeploymentName": "text-embedding-3-small",
    "ApiKey": "YOUR_AZURE_OPENAI_API_KEY_HERE"
  },
  "AzureAiSearch": {
    "Endpoint": "YOUR_AZURE_AI_SEARCH_ENDPOINT_HERE",
    "IndexName": "servicedesk-knowledge-index",
    "ApiKey": "YOUR_AZURE_AI_SEARCH_API_KEY_HERE"
  },
  "AzureBlobStorage": {
    "ConnectionString": "YOUR_AZURE_BLOB_STORAGE_CONNECTION_STRING_HERE",
    "ContainerName": "knowledge"
  },
  "AzureAiFoundry": {
    "ProjectEndpoint": "YOUR_AZURE_AI_FOUNDRY_PROJECT_ENDPOINT_HERE",
    "ApiKey": "YOUR_AZURE_AI_FOUNDRY_API_KEY_HERE",
    "PlannerAgentName": "it-planner-agent",
    "SupportSpecialistAgentName": "it-support-specialist-agent",
    "ReviewerAgentName": "it-reviewer-agent"
  },
  "ApplicationInsights": {
    "ConnectionString": "YOUR_APP_INSIGHTS_CONNECTION_STRING_HERE"
  },
  "FeatureFlags": {
    "UseMockAiProvider": false,
    "UseMockSearchProvider": false,
    "UseMockTicketGateway": false
  }
}
