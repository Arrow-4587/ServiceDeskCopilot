@model IReadOnlyList<ServiceDesk.Domain.Entities.IncidentDraft>
@using ServiceDesk.Domain.Enums
@{
    ViewData["Title"] = "Incident Workspace";
    var totalCount = Model?.Count ?? 0;
    var pendingCount = Model?.Count(i => i.ApprovalStatus == ApprovalStatus.Pending) ?? 0;
    var approvedCount = Model?.Count(i => i.ApprovalStatus == ApprovalStatus.Approved) ?? 0;
    var rejectedCount = Model?.Count(i => i.ApprovalStatus == ApprovalStatus.Rejected) ?? 0;
    var requesterMap = ViewBag.RequesterMap as IDictionary<Guid, (string DisplayName, string Role)>;
}

<div class="dashboard-page w-100">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 pb-2 border-bottom" style="border-color:var(--border-soft) !important;">
        <div>
            <h3 class="fw-bold mb-1" style="color:var(--text-heading);letter-spacing:-0.3px;">
                <i class="bi bi-shield-check text-primary me-2"></i> Enterprise Incident Management Workspace
            </h3>
            <p class="text-muted small mb-0">
                Review, approve, and submit IT incident drafts generated by Copilot diagnostic workflows.
            </p>
        </div>
        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
            <button type="button" id="btnCreateIncidentManual" class="btn btn-sm btn-gradient rounded-3 px-3 py-2 fw-semibold">
                <i class="bi bi-plus-lg me-1"></i> Create Incident Draft
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-x-circle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Metric Summary Cards -->
    <div class="stat-cards mb-4">
        <div class="stat-card">
            <div class="stat-card-accent" style="background:var(--brand-blue);"></div>
            <div class="stat-card-icon" style="background:var(--brand-blue-light);color:var(--brand-blue);">
                <i class="bi bi-inbox-fill"></i>
            </div>
            <div class="stat-card-body">
                <div class="stat-label">Total Incidents</div>
                <div class="stat-value">@totalCount</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-accent" style="background:var(--warning);"></div>
            <div class="stat-card-icon" style="background:rgba(217,119,6,0.12);color:var(--warning);">
                <i class="bi bi-clock-history"></i>
            </div>
            <div class="stat-card-body">
                <div class="stat-label">Pending Approval</div>
                <div class="stat-value">@pendingCount</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-accent" style="background:var(--success);"></div>
            <div class="stat-card-icon" style="background:rgba(16,185,129,0.12);color:var(--success);">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="stat-card-body">
                <div class="stat-label">Approved &amp; Submitted</div>
                <div class="stat-value">@approvedCount</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-accent" style="background:var(--danger);"></div>
            <div class="stat-card-icon" style="background:rgba(239,68,68,0.12);color:var(--danger);">
                <i class="bi bi-x-circle-fill"></i>
            </div>
            <div class="stat-card-body">
                <div class="stat-label">Rejected Drafts</div>
                <div class="stat-value">@rejectedCount</div>
            </div>
        </div>
    </div>

    <!-- Main Workspace Table Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background:var(--bg-surface); border: 1px solid var(--border-soft) !important;">
        
        <!-- Filter Toolbar -->
        <div class="p-3 border-bottom" style="background:var(--bg-surface-alt);border-color:var(--border-soft) !important;">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-5">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text border-end-0" style="background:var(--bg-surface);border-color:var(--border-soft);color:var(--text-muted);">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="incSearchInput" class="form-control border-start-0" placeholder="Search ticket title, ID, category..." style="background:var(--bg-surface);border-color:var(--border-soft);color:var(--text-heading);" />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select id="incPriorityFilter" class="form-select form-select-sm" style="background:var(--bg-surface);border-color:var(--border-soft);color:var(--text-heading);">
                        <option value="">All Priorities</option>
                        <option value="Critical">Critical (P1)</option>
                        <option value="High">High (P2)</option>
                        <option value="Medium">Medium (P3)</option>
                        <option value="Low">Low (P4)</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <select id="incStatusFilter" class="form-select form-select-sm" style="background:var(--bg-surface);border-color:var(--border-soft);color:var(--text-heading);">
                        <option value="">All Statuses</option>
                        <option value="Draft">Draft</option>
                        <option value="Submitted">Submitted</option>
                        <option value="Pending">Pending</option>
                        <option value="Approved">Approved</option>
                        <option value="Rejected">Rejected</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 text-md-end">
                    <button type="button" id="btnResetIncFilters" class="btn btn-sm btn-outline-secondary w-100" style="border-radius:8px;">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                    </button>
                </div>
            </div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox text-secondary fs-1 mb-3 d-block"></i>
                <h5 style="color:var(--text-heading);">No Incident Drafts Found</h5>
                <p class="text-muted small">
                    Incident drafts are automatically created when Copilot chat identifies an unresolved IT outage or when you request ticket creation.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="incidentTable" class="table table-hover align-middle mb-0" data-paginate="10" style="font-size:0.875rem;--bs-table-bg:var(--bg-surface);--bs-table-color:var(--text-body);">
                    <thead style="background:var(--bg-surface-alt);color:var(--text-muted);font-size:0.78rem;text-transform:uppercase;">
                        <tr>
                            <th class="ps-4">Ticket Title</th>
                            <th>Raised By</th>
                            <th>Category</th>
                            <th>Priority</th>
                            <th>Approval Gate</th>
                            <th>Status</th>
                            <th>Created Date</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="incidentTableBody">
                        @foreach (var draft in Model)
                        {
                            string priorityClass = draft.ComputedPriority switch
                            {
                                IncidentPriority.Critical => "badge-priority-critical",
                                IncidentPriority.High => "badge-priority-high",
                                IncidentPriority.Medium => "badge-priority-medium",
                                _ => "badge-priority-low"
                            };

                            string approvalBadge = draft.ApprovalStatus switch
                            {
                                ApprovalStatus.Approved => "bg-success text-white",
                                ApprovalStatus.Rejected => "bg-danger text-white",
                                _ => "bg-warning text-dark"
                            };

                            string reqName = "Unknown";
                            string reqRole = "";
                            if (requesterMap != null && requesterMap.TryGetValue(draft.UserId, out var reqInfo) && !string.IsNullOrWhiteSpace(reqInfo.DisplayName))
                            {
                                reqName = reqInfo.DisplayName;
                                reqRole = reqInfo.Role;
                            }
                            else if (draft.UserId == Guid.Empty)
                            {
                                reqName = "System";
                            }

                            <tr class="inc-row" data-priority="@draft.ComputedPriority" data-status="@draft.Status" data-approval="@draft.ApprovalStatus">
                                <td class="ps-4 fw-semibold ticket-title-col" style="color:var(--text-heading);">
                                    <div class="ticket-title-clamp" title="@draft.Title" aria-label="@draft.Title" tabindex="0">
                                        @draft.Title
                                    </div>
                                </td>
                                <td class="text-nowrap" style="color:var(--text-body);">
                                    <span class="d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-person-circle text-muted me-1" style="font-size:0.85rem;"></i>
                                        <span class="fw-medium" style="color:var(--text-heading);">@reqName</span>
                                        @if (!string.IsNullOrWhiteSpace(reqRole))
                                        {
                                            <span class="badge bg-secondary bg-opacity-25 text-body border border-secondary border-opacity-25 ms-1" style="font-size:0.7rem;font-weight:500;">@reqRole</span>
                                        }
                                    </span>
                                </td>
                                <td><span class="badge bg-secondary bg-opacity-50">@draft.Category</span></td>
                                <td>
                                    <span class="badge @priorityClass px-2 py-1">
                                        <i class="bi bi-lightning-fill me-1"></i> P@((int)draft.ComputedPriority) - @draft.ComputedPriority
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @approvalBadge px-2 py-1">
                                        @draft.ApprovalStatus
                                    </span>
                                </td>
                                <td>
                                    @if (draft.Status == IncidentStatus.Submitted)
                                    {
                                        <span class="text-info small fw-semibold"><i class="bi bi-check2-all me-1"></i> Submitted (@draft.SubmittedIncidentId)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">@draft.Status</span>
                                    }
                                </td>
                                <td class="text-muted small">@draft.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@draft.Id" class="btn btn-outline-primary btn-sm rounded-3 px-3 py-1">
                                        <i class="bi bi-eye-fill me-1"></i> Review &amp; Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const btnCreate = document.getElementById('btnCreateIncidentManual');
        if (btnCreate) {
            btnCreate.addEventListener('click', function() {
                const title = prompt("Enter a brief title for your issue (minimum 5 characters):");
                if (!title) return;
                const desc = prompt("Enter details of your issue (minimum 15 characters):");
                if (!desc) return;

                fetch('/Incident/CreateDraftManual', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title: title, description: desc })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.draftId) {
                        window.location.href = '/Incident/Details/' + data.draftId;
                    } else {
                        alert('Failed to generate incident draft.');
                    }
                })
                .catch(err => {
                    alert('An error occurred while creating the draft.');
                });
            });
        }

        const searchInput = $('#incSearchInput');
        const prioFilter = $('#incPriorityFilter');
        const statusFilter = $('#incStatusFilter');
        const incTableEl = document.getElementById('incidentTable');

        function applyIncFilters() {
            if (!incTableEl) return;
            const rows = $('#incidentTableBody tr.inc-row');
            if (!rows.length) return;

            const q = (searchInput.val() || '').toLowerCase().trim();
            const prio = (prioFilter.val() || '').toLowerCase();
            const status = (statusFilter.val() || '').toLowerCase();

            rows.each(function() {
                const $row = $(this);
                const rowText = $row.text().toLowerCase();
                const rowPrio = ($row.attr('data-priority') || '').toLowerCase();
                const rowStatus = ($row.attr('data-status') || '').toLowerCase();
                const rowApproval = ($row.attr('data-approval') || '').toLowerCase();

                const matchesQuery = !q || rowText.indexOf(q) !== -1;
                const matchesPrio = !prio || rowPrio === prio;
                const matchesStatus = !status || rowStatus === status || rowApproval === status;

                if (matchesQuery && matchesPrio && matchesStatus) {
                    delete this.dataset.filteredOut;
                } else {
                    this.dataset.filteredOut = 'true';
                }
            });

            if (incTableEl.tablePaginator) {
                incTableEl.tablePaginator.update(true);
            }
        }

        searchInput.on('input', applyIncFilters);
        prioFilter.on('change', applyIncFilters);
        statusFilter.on('change', applyIncFilters);

        $('#btnResetIncFilters').click(function() {
            searchInput.val('');
            prioFilter.val('');
            statusFilter.val('');
            applyIncFilters();
        });
    });
</script>
}
