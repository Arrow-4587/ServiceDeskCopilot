@Html.AntiForgeryToken()
<div class="modal fade" id="kbUploadModal" tabindex="-1" aria-labelledby="kbUploadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4" style="background:var(--bg-surface);border:1px solid var(--border-soft) !important;">
            <div class="modal-header py-3 px-4 border-bottom" style="border-color:var(--border-soft) !important;">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-3 p-2 d-flex align-items-center justify-content-center" style="background:rgba(37,99,235,0.1);width:38px;height:38px;">
                        <i class="bi bi-cloud-arrow-up-fill text-primary fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="kbUploadModalLabel" style="color:var(--text-heading);font-size:1.1rem;">Upload Policy Document</h5>
                        <p class="text-muted small mb-0">Upload official Markdown (.md) document to Azure Blob Storage &amp; Azure AI Search.</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="btnKbUploadClose"></button>
            </div>
            
            <form id="kbUploadForm" enctype="multipart/form-data">
                <div class="modal-body p-4">
                    <!-- Status / Alert Area -->
                    <div id="kbUploadAlert" class="alert mb-3" style="display:none;" role="alert"></div>

                    <!-- Drag & Drop Area -->
                    <div id="kbDropZone" class="p-4 rounded-4 text-center mb-3 transition-all" 
                         style="border: 2px dashed var(--border-soft); background: var(--bg-surface-alt, rgba(0,0,0,0.02)); cursor: pointer;">
                        <input type="file" id="kbFileInput" name="policyFile" accept=".md" class="d-none" required />
                        <div class="py-3">
                            <i class="bi bi-file-earmark-arrow-up display-5 text-primary mb-3 d-inline-block"></i>
                            <h6 class="fw-semibold mb-1" style="color:var(--text-heading);">Drag and drop your Markdown file here, or <span class="text-primary text-decoration-underline">browse</span></h6>
                            <p class="text-muted small mb-0">Accepted format: <strong>.md (Markdown)</strong> only. Max file size: <strong>10 MB</strong>.</p>
                        </div>
                    </div>

                    <!-- Selected File Preview Card (Hidden until file selected) -->
                    <div id="kbFilePreview" class="card rounded-3 border p-3 mb-3" style="display:none;background:var(--bg-surface);border-color:var(--border-soft) !important;">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3 min-w-0">
                                <div class="rounded-3 p-2 bg-primary-subtle text-primary">
                                    <i class="bi bi-file-earmark-text-fill fs-4"></i>
                                </div>
                                <div class="min-w-0">
                                    <div id="kbFileNameDisplay" class="fw-semibold text-truncate" style="color:var(--text-heading);font-size:0.95rem;"></div>
                                    <div class="d-flex align-items-center gap-2 text-muted small">
                                        <span id="kbFileSizeDisplay"></span>
                                        <span>&bull;</span>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">.md Markdown</span>
                                    </div>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger border-0" id="btnRemoveKbFile" title="Remove selected file">
                                <i class="bi bi-trash3-fill"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Metadata Fields (Optional Overrides) -->
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label for="kbDocumentTitleInput" class="form-label small fw-semibold" style="color:var(--text-heading);">Document Title <span class="text-muted fw-normal">(Optional, extracted from file by default)</span></label>
                            <input type="text" class="form-control form-control-sm" id="kbDocumentTitleInput" name="documentTitle" placeholder="e.g. Enterprise Remote Access Policy" style="background:var(--bg-surface);border-color:var(--border-soft);color:var(--text-heading);" />
                        </div>
                        <div class="col-md-5">
                            <label for="kbSectionInput" class="form-label small fw-semibold" style="color:var(--text-heading);">Section / Category <span class="text-muted fw-normal">(Optional)</span></label>
                            <input type="text" class="form-control form-control-sm" id="kbSectionInput" name="section" placeholder="e.g. Security &amp; Access" style="background:var(--bg-surface);border-color:var(--border-soft);color:var(--text-heading);" />
                        </div>
                    </div>

                    <!-- Ingestion Pipeline Notice -->
                    <div class="mt-3 p-2.5 rounded-3 d-flex align-items-start gap-2" style="background:var(--brand-blue-light, rgba(37,99,235,0.06));border:1px solid rgba(37,99,235,0.15);font-size:0.8rem;color:var(--text-muted);">
                        <i class="bi bi-info-circle-fill text-primary flex-shrink-0 mt-0.5"></i>
                        <div>
                            Upon upload, the document is securely stored in Azure Blob Storage, chunked with semantic boundaries, indexed with embeddings, and immediately made available to Copilot agents.
                        </div>
                    </div>

                    <!-- Loading / Processing State -->
                    <div id="kbUploadProgressState" class="mt-3 py-3 text-center rounded-3 border" style="display:none;background:var(--bg-surface-alt, rgba(0,0,0,0.02));border-color:var(--border-soft) !important;">
                        <div class="spinner-border text-primary spinner-border-sm mb-2" role="status"></div>
                        <div class="fw-semibold small" id="kbUploadProgressText" style="color:var(--text-heading);">Uploading to Azure Blob Storage &amp; generating AI embeddings...</div>
                        <div class="text-muted small" style="font-size:0.75rem;">This may take a few seconds as chunks are indexed into Azure AI Search.</div>
                    </div>
                </div>

                <div class="modal-footer py-3 px-4 border-top" style="border-color:var(--border-soft) !important;">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal" id="btnCancelKbUpload" style="border-radius:8px;">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-2" id="btnSubmitKbUpload" disabled style="border-radius:8px;font-weight:600;">
                        <i class="bi bi-cloud-arrow-up-fill"></i>
                        <span>Upload &amp; Ingest</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
