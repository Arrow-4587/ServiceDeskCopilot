@{
    ViewData["Title"] = "Chat History";
    var historyItems = ViewBag.HistoryItems as IEnumerable<dynamic>;
    var totalSessions = historyItems?.Count() ?? 0;
    var activeSessions = historyItems?.Count(i => (i.Session as ServiceDesk.Domain.Entities.ConversationSession)?.IsActive == true) ?? 0;
    var closedSessions = totalSessions - activeSessions;
}

<div class="dashboard-page w-100">
    <!-- Header Block aligned with Incidents & KB Page Headers -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 pb-2 border-bottom gap-3" style="border-color:var(--border-soft) !important;">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1.5 flex-wrap">
                <span class="badge rounded-pill px-2.5 py-1" style="background:var(--accent-muted);color:var(--accent);border:1px solid var(--border-soft);font-size:0.75rem;font-weight:700;">
                    <i class="bi bi-robot me-1"></i>Enterprise IT Copilot
                </span>
                <span class="badge rounded-pill px-2.5 py-1" style="background:rgba(2,132,199,0.12);color:var(--accent-teal);border:1px solid rgba(2,132,199,0.3);font-size:0.75rem;font-weight:600;">
                    <i class="bi bi-journal-text me-1"></i>Grounded RAG
                </span>
                <span class="badge rounded-pill px-2.5 py-1" style="background:rgba(124,58,237,0.12);color:var(--accent-violet);border:1px solid rgba(124,58,237,0.3);font-size:0.75rem;font-weight:600;">
                    <i class="bi bi-lightning-charge me-1"></i>ITSM Dispatch
                </span>
            </div>
            <h3 class="fw-bold mb-1" style="color:var(--text-heading);letter-spacing:-0.3px;">
                <i class="bi bi-clock-history text-primary me-2"></i>Chat History
            </h3>
            <p class="small mb-0" style="color:var(--text-muted);">
                Review past AI Copilot conversations, grounded RAG citations, and automated ITSM dispatch request trails.
            </p>
        </div>
        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
            <a href="@Url.Action("Index", "Chat")" class="btn btn-sm btn-gradient rounded-3 px-3 py-2 fw-semibold shadow-sm">
                <i class="bi bi-chat-dots-fill me-1.5"></i> Start New Copilot Session
            </a>
        </div>
    </div>

    <!-- Stat Summary Bar -->
    <div class="stat-cards mb-4">
        <div class="stat-card">
            <div class="stat-card-accent" style="background:var(--brand-blue);"></div>
            <div class="stat-card-icon" style="background:var(--brand-blue-light);color:var(--brand-blue);">
                <i class="bi bi-chat-square-text-fill"></i>
            </div>
            <div class="stat-card-body">
                <div class="stat-label">Total Sessions</div>
                <div class="stat-value">@totalSessions</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-accent" style="background:var(--success);"></div>
            <div class="stat-card-icon" style="background:rgba(16,185,129,0.12);color:var(--success);">
                <i class="bi bi-record-circle-fill"></i>
            </div>
            <div class="stat-card-body">
                <div class="stat-label">Active Sessions</div>
                <div class="stat-value">@activeSessions</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-accent" style="background:var(--text-muted);"></div>
            <div class="stat-card-icon" style="background:rgba(148,163,184,0.12);color:var(--text-muted);">
                <i class="bi bi-archive-fill"></i>
            </div>
            <div class="stat-card-body">
                <div class="stat-label">Closed Sessions</div>
                <div class="stat-value">@closedSessions</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-accent" style="background:var(--accent-teal);"></div>
            <div class="stat-card-icon" style="background:rgba(2,132,199,0.12);color:var(--accent-teal);">
                <i class="bi bi-shield-check"></i>
            </div>
            <div class="stat-card-body">
                <div class="stat-label">Grounded Queries</div>
                <div class="stat-value">@totalSessions</div>
            </div>
        </div>
    </div>

    <!-- Main Table & Filter Toolbar Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background:var(--bg-surface); border: 1px solid var(--border-soft) !important;">
        
        <!-- Filter & Search Toolbar -->
        <div class="p-3 border-bottom" style="background:var(--bg-surface-alt);border-color:var(--border-soft) !important;">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-5">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text border-end-0" style="background:var(--bg-surface);border-color:var(--border-soft);color:var(--text-muted);">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="chatSearchInput" class="form-control border-start-0" placeholder="Search conversation prompt, ID, role..." style="background:var(--bg-surface);border-color:var(--border-soft);color:var(--text-heading);" />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select id="chatStatusFilter" class="form-select form-select-sm" style="background:var(--bg-surface);border-color:var(--border-soft);color:var(--text-heading);">
                        <option value="">All Statuses</option>
                        <option value="Active">Active</option>
                        <option value="Closed">Closed</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <select id="chatRoleFilter" class="form-select form-select-sm" style="background:var(--bg-surface);border-color:var(--border-soft);color:var(--text-heading);">
                        <option value="">All Roles</option>
                        <option value="Administrator">Administrator</option>
                        <option value="Manager">Manager</option>
                        <option value="Analyst">Analyst</option>
                        <option value="Employee">Employee</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 text-md-end">
                    <button type="button" id="btnResetChatFilters" class="btn btn-sm btn-outline-secondary w-100" style="border-radius:8px;">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                    </button>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            @if (historyItems != null && historyItems.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle small mb-0" id="chatHistoryTable" data-paginate="10" style="color:var(--text-body);">
                        <thead style="background:var(--bg-surface-alt);border-bottom:1px solid var(--border-soft) !important;">
                            <tr>
                                <th class="ps-4 py-3" style="color:var(--text-heading);font-weight:600;min-width:280px;">Conversation Topic &amp; Summary</th>
                                <th class="py-3" style="color:var(--text-heading);font-weight:600;">Initiator Role</th>
                                <th class="py-3" style="color:var(--text-heading);font-weight:600;min-width:160px;">Date Started</th>
                                <th class="py-3" style="color:var(--text-heading);font-weight:600;">Messages</th>
                                <th class="py-3" style="color:var(--text-heading);font-weight:600;">Status</th>
                                <th class="pe-4 py-3 text-end" style="color:var(--text-heading);font-weight:600;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in historyItems)
                            {
                                var session = item.Session as ServiceDesk.Domain.Entities.ConversationSession;
                                var role = item.Role as string;
                                if (session == null) continue;

                                var messages = session.Messages?.OrderBy(m => m.Timestamp).ToList();
                                var firstUserMsg = messages?.FirstOrDefault(m => string.Equals(m.SenderRole, "User", StringComparison.OrdinalIgnoreCase))?.Content
                                                ?? messages?.FirstOrDefault()?.Content
                                                ?? "Copilot Conversation Session";

                                var hasCitations = messages != null && messages.Any(m => m.Citations != null && m.Citations.Any());

                                var roleStyle = role switch
                                {
                                    "Administrator" => "background:rgba(124,58,237,0.12);color:var(--accent-violet, #7c3aed);border:1px solid rgba(124,58,237,0.3);",
                                    "Manager" => "background:rgba(245,158,11,0.12);color:var(--warning, #d97706);border:1px solid rgba(245,158,11,0.3);",
                                    "Analyst" => "background:rgba(2,132,199,0.12);color:var(--accent-teal, #0284c7);border:1px solid rgba(2,132,199,0.3);",
                                    "Employee" => "background:rgba(37,99,235,0.12);color:var(--brand-blue, #2563eb);border:1px solid rgba(37,99,235,0.3);",
                                    _ => "background:var(--bg-surface-alt);color:var(--text-muted);border:1px solid var(--border-soft);"
                                };

                                var statusText = session.IsActive ? "Active" : "Closed";

                                <tr class="chat-row" data-role="@role" data-status="@statusText" style="border-bottom:1px solid var(--border-soft);transition:background-color 0.15s ease;">
                                    <td class="ps-4 py-2.5 chat-topic-col">
                                        <div class="d-flex align-items-start gap-2.5">
                                            <div class="rounded-circle p-2 d-flex align-items-center justify-content-center flex-shrink-0 mt-0.5" style="background:var(--accent-muted);color:var(--accent);width:32px;height:32px;">
                                                <i class="bi bi-robot" style="font-size:0.95rem;"></i>
                                            </div>
                                            <div class="min-w-0 flex-grow-1">
                                                <div class="fw-semibold chat-topic-clamp" style="color:var(--text-heading);font-size:0.88rem;" title="@firstUserMsg" aria-label="@firstUserMsg" tabindex="0">
                                                    @firstUserMsg
                                                </div>
                                                <div class="d-flex align-items-center gap-2 mt-1">
                                                    <span class="font-monospace small" style="color:var(--text-muted);font-size:0.75rem;">
                                                        ID: @session.Id.ToString().Substring(0, 8)...
                                                    </span>
                                                    @if (hasCitations)
                                                    {
                                                        <span class="badge rounded-pill px-2 py-0.5" style="background:rgba(2,132,199,0.1);color:var(--accent-teal);border:1px solid rgba(2,132,199,0.25);font-size:0.7rem;font-weight:600;">
                                                            <i class="bi bi-journal-check me-1"></i>RAG Grounded
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill px-2.5 py-1" style="@roleStyle font-weight:600;">
                                            @role
                                        </span>
                                    </td>
                                    <td class="text-nowrap">
                                        <div class="d-inline-flex flex-column">
                                            <span class="fw-semibold" style="color:var(--text-heading);font-size:0.85rem;">
                                                <i class="bi bi-calendar3 me-1 text-primary" style="font-size:0.8rem;"></i>@session.StartedAt.ToLocalTime().ToString("MMM dd, yyyy")
                                            </span>
                                            <span class="font-monospace small mt-0.5" style="font-size:0.78rem;color:var(--text-muted) !important;">
                                                <i class="bi bi-clock me-1 text-muted" style="font-size:0.75rem;"></i>@session.StartedAt.ToLocalTime().ToString("hh:mm tt")
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill px-2.5 py-1" style="background:rgba(37,99,235,0.12);color:var(--brand-blue,#2563eb);border:1px solid rgba(37,99,235,0.3);font-weight:600;">
                                            <i class="bi bi-chat-text me-1"></i>@(messages?.Count ?? 0) msgs
                                        </span>
                                    </td>
                                    <td>
                                        @if (session.IsActive)
                                        {
                                            <span class="badge rounded-pill status-badge-operational px-2.5 py-1" style="font-weight:600;">
                                                <i class="bi bi-circle-fill me-1" style="font-size:0.45rem;"></i>Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle px-2.5 py-1" style="font-weight:600;">
                                                Closed
                                            </span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        <a href="@Url.Action("Index", "Chat", new { conversationId = session.Id })" class="btn btn-sm btn-primary rounded-3 px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5 shadow-sm" aria-label="Open conversation session @session.Id">
                                            <i class="bi bi-box-arrow-up-right me-1"></i> Open
                                        </a>
                                    </td>
                                </tr>
                            }
                            <tr id="noMatchRow" style="display:none;">
                                <td colspan="6" class="text-center py-5">
                                    <i class="bi bi-search text-muted fs-2 mb-2 d-block opacity-50"></i>
                                    <h6 class="fw-bold mb-1" style="color:var(--text-heading);">No matching conversations found</h6>
                                    <p class="small text-muted mb-3">Try adjusting your search terms or status filters.</p>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="document.getElementById('btnResetChatFilters').click();">
                                        Clear Filters
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-chat-square-dots text-muted fs-1 mb-3 d-block opacity-50"></i>
                    <h5 class="fw-bold" style="color:var(--text-heading);">No chat history found</h5>
                    <p class="small max-w-md mx-auto" style="color:var(--text-muted);">
                        You haven't started any AI Copilot conversations yet. Click below to begin a new session.
                    </p>
                    <a href="@Url.Action("Index", "Chat")" class="btn btn-sm btn-primary mt-2 rounded-3 px-3 py-2 fw-semibold">
                        Start First Conversation
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .chat-row:hover {
        background-color: var(--bg-surface-alt) !important;
        border-left: 3px solid var(--accent) !important;
    }
    .chat-row:focus-within {
        background-color: var(--bg-surface-alt) !important;
        outline: 2px solid var(--accent);
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var searchInput = document.getElementById('chatSearchInput');
        var statusFilter = document.getElementById('chatStatusFilter');
        var roleFilter = document.getElementById('chatRoleFilter');
        var btnReset = document.getElementById('btnResetChatFilters');
        var rows = document.querySelectorAll('.chat-row');
        var noMatchRow = document.getElementById('noMatchRow');

        var chatTableEl = document.getElementById('chatHistoryTable');

        function filterRows() {
            var query = searchInput ? searchInput.value.trim().toLowerCase() : '';
            var selectedStatus = statusFilter ? statusFilter.value : '';
            var selectedRole = roleFilter ? roleFilter.value : '';

            var visibleCount = 0;

            rows.forEach(function (row) {
                var text = row.innerText.toLowerCase();
                var role = row.getAttribute('data-role') || '';
                var status = row.getAttribute('data-status') || '';

                var matchesQuery = !query || text.includes(query);
                var matchesStatus = !selectedStatus || status === selectedStatus;
                var matchesRole = !selectedRole || role.toLowerCase() === selectedRole.toLowerCase();

                if (matchesQuery && matchesStatus && matchesRole) {
                    row.style.display = '';
                    row.removeAttribute('data-filtered-out');
                    delete row.dataset.filteredOut;
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                    row.setAttribute('data-filtered-out', 'true');
                    row.dataset.filteredOut = 'true';
                }
            });

            if (noMatchRow) {
                noMatchRow.style.display = (visibleCount === 0 && rows.length > 0) ? '' : 'none';
            }

            if (chatTableEl && chatTableEl.tablePaginator) {
                try {
                    chatTableEl.tablePaginator.update(true);
                } catch (e) { }
            }
        }

        if (searchInput) searchInput.addEventListener('input', filterRows);
        if (statusFilter) statusFilter.addEventListener('change', filterRows);
        if (roleFilter) roleFilter.addEventListener('change', filterRows);

        rows.forEach(function (row) {
            row.style.cursor = 'pointer';
            row.addEventListener('click', function (e) {
                if (e.target.closest('a') || e.target.closest('button')) return;
                var openBtn = row.querySelector('a.btn-primary');
                if (openBtn && openBtn.href) {
                    window.location.href = openBtn.href;
                }
            });
        });

        if (btnReset) {
            btnReset.addEventListener('click', function () {
                if (searchInput) searchInput.value = '';
                if (statusFilter) statusFilter.value = '';
                if (roleFilter) roleFilter.value = '';
                filterRows();
            });
        }
    });
</script>
