@model ServiceDesk.Domain.Entities.IncidentDraft
@using ServiceDesk.Domain.Enums
@using ServiceDesk.Application.DTOs.Incident
@{
    ViewData["Title"] = "Incident Review & Approval Workspace";
    var reviewResult = ViewBag.ReviewResult as IncidentReviewResultDto;
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">
        <i class="bi bi-arrow-left me-1"></i> Back to Incident Workspace
    </a>
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
            <h3 class="fw-bold mb-1">Review & Approve Ticket Draft</h3>
            <p class="text-muted mb-0 small">Audit AI privacy sanitization, priority calculations, and complete human-in-the-loop review.</p>
        </div>
        <div>
            <span class="badge @(Model.ApprovalStatus == ApprovalStatus.Approved ? "bg-success" : Model.ApprovalStatus == ApprovalStatus.Rejected ? "bg-danger" : "bg-warning text-dark") fs-6 px-3 py-2 rounded-pill shadow-sm">
                <i class="bi bi-shield-check me-1"></i> Gate: @Model.ApprovalStatus
            </span>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm mb-4 d-flex align-items-center" role="alert">
        <i class="bi bi-check-circle-fill me-2 fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
    </div>
}
@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning border-0 shadow-sm mb-4 d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
        <div>@TempData["WarningMessage"]</div>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm mb-4 d-flex align-items-center" role="alert">
        <i class="bi bi-x-circle-fill me-2 fs-5"></i>
        <div>@TempData["ErrorMessage"]</div>
    </div>
}

<div class="row g-4">
    <!-- Left Column: Draft Content & Edits -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                <div class="d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold mb-0 text-primary"><i class="bi bi-file-earmark-text me-2"></i> Ticket Content</h5>
                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1 small">
                        ID: @Model.Id.ToString().Substring(0, 8)...
                    </span>
                </div>
            </div>
            <div class="card-body p-4">
                
                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold">Incident Title</label>
                    @if (User.IsInRole("Analyst") && Model.ApprovalStatus == ApprovalStatus.Pending && Model.AssignedAnalystId == Guid.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? Guid.Empty.ToString()))
                    {
                        <input type="text" name="title" form="updateForm" class="form-control" value="@(Model.Title)" />
                    }
                    else
                    {
                        <div class="p-3 rounded bg-body-tertiary border text-body fw-semibold">
                            @(reviewResult?.RedactedTitle ?? Model.Title)
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold">Description</label>
                    @if (User.IsInRole("Analyst") && Model.ApprovalStatus == ApprovalStatus.Pending && Model.AssignedAnalystId == Guid.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? Guid.Empty.ToString()))
                    {
                        <textarea name="description" form="updateForm" class="form-control" rows="5">@(Model.Description)</textarea>
                    }
                    else
                    {
                        <div class="p-3 rounded bg-body-tertiary border text-body-secondary" style="white-space: pre-wrap;">@(reviewResult?.RedactedDescription ?? Model.Description)</div>
                    }
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label text-muted small fw-semibold">Category</label>
                        @if (User.IsInRole("Analyst") && Model.ApprovalStatus == ApprovalStatus.Pending && Model.AssignedAnalystId == Guid.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? Guid.Empty.ToString()))
                        {
                            <input type="text" name="category" form="updateForm" class="form-control" value="@Model.Category" />
                        }
                        else
                        {
                            <div class="p-2.5 rounded bg-body-tertiary border text-body small">
                                @Model.Category
                            </div>
                        }
                    </div>
                    <div class="col-6">
                        <label class="form-label text-muted small fw-semibold">Submitted Ticket ID</label>
                        <div class="p-2.5 rounded bg-body-tertiary border text-primary font-monospace small fw-medium">
                            @(Model.SubmittedIncidentId ?? "Not Submitted Yet")
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.SystemStatusEvidence))
                {
                    <div class="mt-3">
                        <label class="form-label text-muted small fw-semibold"><i class="bi bi-activity text-success me-1"></i> System Status Evidence</label>
                        <div class="p-3 rounded bg-success bg-opacity-10 border border-success border-opacity-25 text-success font-monospace small">
                            @Model.SystemStatusEvidence
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Agent Reviewer & Approval Form -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                <h5 class="fw-bold mb-0 text-primary"><i class="bi bi-robot me-2"></i> Reviewer Agent Audit</h5>
            </div>
            <div class="card-body p-4">

                <!-- Privacy Redaction Audit -->
                <div class="p-3 rounded mb-3 @(reviewResult != null && reviewResult.PrivacyCheckPassed ? "bg-success bg-opacity-10 border border-success border-opacity-25" : "bg-warning bg-opacity-10 border border-warning border-opacity-25")">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="small fw-semibold text-body">
                            <i class="bi bi-shield-lock me-1"></i> Secret & Privacy Sanitization
                        </span>
                        @if (reviewResult != null && reviewResult.PrivacyCheckPassed)
                        {
                            <span class="badge bg-success">Passed</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Secrets Redacted</span>
                        }
                    </div>
                    <p class="text-muted small mb-0">
                        Scanned for API keys, credentials, connection strings, and private keys.
                    </p>
                </div>

                <!-- Deterministic Priority Audit -->
                <div class="p-3 rounded bg-body-tertiary border mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small text-muted">Impact / Urgency:</span>
                        <span class="small fw-semibold text-body">@Model.Impact / @Model.Urgency</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-muted">Calculated Priority Matrix:</span>
                        <span class="badge bg-primary px-2.5 py-1">
                            P@((int)Model.ComputedPriority) - @Model.ComputedPriority
                        </span>
                    </div>
                </div>

                <!-- Completeness & Validation Feedback -->
                @if (reviewResult != null && reviewResult.ValidationFeedback.Any())
                {
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold"><i class="bi bi-list-check me-1"></i> Completeness Checklist:</label>
                        <ul class="list-group list-group-flush bg-transparent small">
                            @foreach (var item in reviewResult.ValidationFeedback)
                            {
                                <li class="list-group-item bg-transparent text-body border-0 px-0 py-1">
                                    <i class="bi bi-check2-circle text-info me-2"></i> @item
                                </li>
                            }
                        </ul>
                    </div>
                }

                <!-- Approval Form -->
                <div class="pt-3 border-top">
                    @if (Model.ApprovalStatus == ApprovalStatus.Pending)
                    {
                        <p class="text-muted small mb-3">
                            <strong>Human Gate Required:</strong> Review details above before authorizing ticket submission.
                        </p>

                        @if (User.IsInRole("Analyst"))
                        {
                            var userIdStr = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                            var userId = userIdStr != null ? Guid.Parse(userIdStr) : Guid.Empty;

                            if (Model.AssignedAnalystId == null)
                            {
                                <form asp-action="AssignToMe" method="post">
                                    <input type="hidden" name="draftId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-primary w-100 fw-semibold mb-3">
                                        <i class="bi bi-person-plus-fill me-1"></i> Assign to Me
                                    </button>
                                </form>
                            }
                            else if (Model.AssignedAnalystId == userId)
                            {
                                <form id="updateForm" asp-action="UpdateDraft" method="post" class="mb-3">
                                    <input type="hidden" name="draftId" value="@Model.Id" />
                                    
                                    <div class="mb-2 d-flex gap-2">
                                        <div class="flex-grow-1">
                                            <label class="form-label text-muted small">Impact</label>
                                            <select name="impact" class="form-select form-select-sm">
                                                <!option value="Low" @(Model.Impact == IncidentImpact.Low ? "selected" : "")>Low</!option>
                                                <!option value="Medium" @(Model.Impact == IncidentImpact.Medium ? "selected" : "")>Medium</!option>
                                                <!option value="High" @(Model.Impact == IncidentImpact.High ? "selected" : "")>High</!option>
                                            </select>
                                        </div>
                                        <div class="flex-grow-1">
                                            <label class="form-label text-muted small">Urgency</label>
                                            <select name="urgency" class="form-select form-select-sm">
                                                <!option value="Low" @(Model.Urgency == IncidentUrgency.Low ? "selected" : "")>Low</!option>
                                                <!option value="Medium" @(Model.Urgency == IncidentUrgency.Medium ? "selected" : "")>Medium</!option>
                                                <!option value="High" @(Model.Urgency == IncidentUrgency.High ? "selected" : "")>High</!option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label text-muted small">Resolution Feedback</label>
                                        <textarea name="feedback" class="form-control" rows="2" placeholder="Optional notes for the user or system..."></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-outline-secondary w-100 fw-semibold">
                                        <i class="bi bi-save me-1"></i> Save Changes
                                    </button>
                                </form>
                            }
                            else
                            {
                                <div class="alert alert-info py-2 mb-3 small">
                                    Assigned to another analyst.
                                </div>
                            }
                        }

                        <div class="d-flex gap-2">
                            <form asp-action="ApproveOrReject" method="post" class="flex-grow-1">
                                <input type="hidden" name="draftId" value="@Model.Id" />
                                <input type="hidden" name="approved" value="true" />
                                <button type="submit" class="btn btn-success w-100 fw-semibold">
                                    <i class="bi bi-check-lg me-1"></i> Approve & Submit
                                </button>
                            </form>

                            <form asp-action="ApproveOrReject" method="post" class="flex-grow-1">
                                <input type="hidden" name="draftId" value="@Model.Id" />
                                <input type="hidden" name="approved" value="false" />
                                <button type="submit" class="btn btn-outline-danger w-100 fw-semibold">
                                    <i class="bi bi-x-lg me-1"></i> Reject Draft
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-2">
                            <i class="bi bi-lock-fill text-secondary fs-4 d-block mb-1"></i>
                            <span class="text-muted small">Decision finalized as <strong>@Model.ApprovalStatus</strong>.</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.ResolutionFeedback))
                        {
                            <div class="mt-3 p-3 rounded bg-body-tertiary border text-body small">
                                <strong class="text-primary">Resolution Feedback:</strong><br />
                                @Model.ResolutionFeedback
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

