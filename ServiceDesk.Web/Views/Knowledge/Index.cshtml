@model IReadOnlyList<ServiceDesk.Application.DTOs.Knowledge.KnowledgeDocumentDto>
@{
    ViewData["Title"] = "Knowledge Base Repository";
}

<div class="dashboard-page w-100">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger glass-card rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.ErrorMessage
        </div>
    }

    @await Html.PartialAsync("_KnowledgeBasePartial", Model)
</div>
