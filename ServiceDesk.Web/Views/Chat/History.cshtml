@{
    ViewData["Title"] = "Chat History";
    var historyItems = ViewBag.HistoryItems as IEnumerable<dynamic>;
}

<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-9">
        <div class="glass-card p-4">
            <div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom border-secondary border-opacity-25">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-info bg-opacity-10 p-2 text-info">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 text-white font-weight-bold">Chat History</h4>
                        <small class="text-muted">Review previous conversations with the IT Copilot</small>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a href="@Url.Action("Index", "Chat")" class="btn btn-outline-info btn-sm rounded-pill px-3">
                        <i class="bi bi-plus-lg me-1"></i> New Conversation
                    </a>
                </div>
            </div>

            @if (historyItems != null && historyItems.Any())
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle border-secondary text-light" data-paginate="10">
                        <thead>
                            <tr>
                                <th>Date Started</th>
                                <th>Initiator Role</th>
                                <th>Messages</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in historyItems)
                            {
                                var session = item.Session as ServiceDesk.Domain.Entities.ConversationSession;
                                var role = item.Role as string;
                                
                                <tr>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <span>@session.StartedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                                            <small class="text-muted">@session.StartedAt.ToLocalTime().ToString("HH:mm")</small>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@role</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark rounded-pill px-2">@session.Messages.Count</span>
                                    </td>
                                    <td>
                                        @if (session.IsActive)
                                        {
                                            <span class="text-success small"><i class="bi bi-circle-fill me-1" style="font-size: 0.6rem;"></i>Active</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><i class="bi bi-circle me-1" style="font-size: 0.6rem;"></i>Closed</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a href="@Url.Action("Index", "Chat", new { conversationId = session.Id })" class="btn btn-sm btn-outline-light rounded-pill">
                                            <i class="bi bi-eye"></i> View Chat
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-secondary fs-1 mb-3 d-block"></i>
                    <h5 class="text-light">No chat history found.</h5>
                    <p class="text-muted small max-w-md mx-auto">
                        You have not started any conversations yet. Click "New Conversation" to begin.
                    </p>
                </div>
            }
        </div>
    </div>
</div>
