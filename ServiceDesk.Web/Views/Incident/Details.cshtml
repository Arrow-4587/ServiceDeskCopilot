@model ServiceDesk.Domain.Entities.IncidentDraft
@using ServiceDesk.Domain.Enums
@using ServiceDesk.Application.DTOs.Incident
@{
    ViewData["Title"] = "Incident Review & Approval Workspace";
    var reviewResult = ViewBag.ReviewResult as IncidentReviewResultDto;
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <a asp-action="Index" class="text-info text-decoration-none small mb-2 d-inline-block">
                    <i class="bi bi-arrow-left me-1"></i> Back to Incident Workspace
                </a>
                <h3 class="text-white font-weight-bold mb-0">Review & Approve Ticket Draft</h3>
            </div>
            <div>
                <span class="badge @(Model.ApprovalStatus == ApprovalStatus.Approved ? "bg-success" : Model.ApprovalStatus == ApprovalStatus.Rejected ? "bg-danger" : "bg-warning text-dark") fs-6 px-3 py-2">
                    <i class="bi bi-shield-check me-1"></i> Gate: @Model.ApprovalStatus
                </span>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success glass-card text-success mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning glass-card text-warning mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["WarningMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger glass-card text-danger mb-4" role="alert">
                <i class="bi bi-x-circle-fill me-2"></i> @TempData["ErrorMessage"]
            </div>
        }

        <div class="row g-4">
            <!-- Left Column: Draft Content & Edits -->
            <div class="col-md-7">
                <div class="glass-card p-4 h-100">
                    <h5 class="text-info mb-3"><i class="bi bi-file-earmark-text me-2"></i> Ticket Content</h5>
                    
                    <div class="mb-3">
                        <label class="form-label text-muted small">Incident Title</label>
                        @if (User.IsInRole("Analyst") && Model.ApprovalStatus == ApprovalStatus.Pending && Model.AssignedAnalystId == Guid.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? Guid.Empty.ToString()))
                        {
                            <input type="text" name="title" form="updateForm" class="form-control bg-dark text-white border-secondary" value="@(Model.Title)" />
                        }
                        else
                        {
                            <div class="p-3 rounded bg-dark border border-secondary text-white font-weight-semibold">
                                @(reviewResult?.RedactedTitle ?? Model.Title)
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small">Description</label>
                        @if (User.IsInRole("Analyst") && Model.ApprovalStatus == ApprovalStatus.Pending && Model.AssignedAnalystId == Guid.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? Guid.Empty.ToString()))
                        {
                            <textarea name="description" form="updateForm" class="form-control bg-dark text-white border-secondary" rows="5">@(Model.Description)</textarea>
                        }
                        else
                        {
                            <div class="p-3 rounded bg-dark border border-secondary text-white-50" style="white-space: pre-wrap;">@(reviewResult?.RedactedDescription ?? Model.Description)</div>
                        }
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label text-muted small">Category</label>
                            @if (User.IsInRole("Analyst") && Model.ApprovalStatus == ApprovalStatus.Pending && Model.AssignedAnalystId == Guid.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? Guid.Empty.ToString()))
                            {
                                <input type="text" name="category" form="updateForm" class="form-control bg-dark text-white border-secondary" value="@Model.Category" />
                            }
                            else
                            {
                                <div class="p-2 rounded bg-dark border border-secondary text-light small">
                                    @Model.Category
                                </div>
                            }
                        </div>
                        <div class="col-6">
                            <label class="form-label text-muted small">Submitted Ticket ID</label>
                            <div class="p-2 rounded bg-dark border border-secondary text-cyan small">
                                @(Model.SubmittedIncidentId ?? "Not Submitted Yet")
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.SystemStatusEvidence))
                    {
                        <div class="mt-3">
                            <label class="form-label text-muted small"><i class="bi bi-activity text-success me-1"></i> System Status Evidence</label>
                            <div class="p-2 rounded bg-dark border border-secondary text-success small font-monospace">
                                @Model.SystemStatusEvidence
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Right Column: Agent Reviewer & Approval Form -->
            <div class="col-md-5">
                <div class="glass-card p-4 mb-4">
                    <h5 class="text-info mb-3"><i class="bi bi-robot me-2"></i> Reviewer Agent Audit</h5>

                    <!-- Privacy Redaction Audit -->
                    <div class="p-3 rounded mb-3 @(reviewResult != null && reviewResult.PrivacyCheckPassed ? "bg-success bg-opacity-10 border border-success border-opacity-25" : "bg-warning bg-opacity-10 border border-warning border-opacity-25")">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="small font-weight-semibold text-white">
                                <i class="bi bi-shield-lock me-1"></i> Secret & Privacy Sanitization
                            </span>
                            @if (reviewResult != null && reviewResult.PrivacyCheckPassed)
                            {
                                <span class="badge bg-success">Passed</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Secrets Redacted</span>
                            }
                        </div>
                        <p class="text-muted small mb-0 mt-1">
                            Scanned for API keys (sk-*), credentials, connection strings, and private keys.
                        </p>
                    </div>

                    <!-- Deterministic Priority Audit -->
                    <div class="p-3 rounded bg-dark border border-secondary mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small text-muted">Impact / Urgency:</span>
                            <span class="small text-white">@Model.Impact / @Model.Urgency</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="small text-muted">Calculated Priority Matrix:</span>
                            <span class="badge badge-priority-high px-2 py-1">
                                P@((int)Model.ComputedPriority) - @Model.ComputedPriority
                            </span>
                        </div>
                    </div>

                    <!-- Completeness & Validation Feedback -->
                    @if (reviewResult != null && reviewResult.ValidationFeedback.Any())
                    {
                        <div class="mb-3">
                            <label class="form-label text-muted small"><i class="bi bi-list-check me-1"></i> Completeness Checklist:</label>
                            <ul class="list-group list-group-flush bg-transparent small">
                                @foreach (var item in reviewResult.ValidationFeedback)
                                {
                                    <li class="list-group-item bg-transparent text-light border-secondary border-opacity-25 px-0 py-1">
                                        <i class="bi bi-check2-circle text-info me-2"></i> @item
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    <!-- Approval Form -->
                    <div class="pt-3 border-top border-secondary border-opacity-25">
                        @if (Model.ApprovalStatus == ApprovalStatus.Pending)
                        {
                            <p class="text-muted small mb-3">
                                <strong>Human Gate Required:</strong> Review the sanitized details above before authorizing ticket submission.
                            </p>

                            @if (User.IsInRole("Analyst"))
                            {
                                var userIdStr = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                                var userId = userIdStr != null ? Guid.Parse(userIdStr) : Guid.Empty;

                                if (Model.AssignedAnalystId == null)
                                {
                                    <form asp-action="AssignToMe" method="post">
                                        <input type="hidden" name="draftId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-primary w-100 font-weight-semibold mb-3">
                                            <i class="bi bi-person-plus-fill me-1"></i> Assign to Me
                                        </button>
                                    </form>
                                }
                                else if (Model.AssignedAnalystId == userId)
                                {
                                    <form id="updateForm" asp-action="UpdateDraft" method="post" class="mb-3">
                                        <input type="hidden" name="draftId" value="@Model.Id" />
                                        
                                        <div class="mb-2 d-flex gap-2">
                                            <div class="flex-grow-1">
                                                <label class="form-label text-muted small">Impact</label>
                                                <select name="impact" class="form-select bg-dark text-white border-secondary form-select-sm">
                                                    <!option value="Low" @(Model.Impact == IncidentImpact.Low ? "selected" : "")>Low</!option>
                                                    <!option value="Medium" @(Model.Impact == IncidentImpact.Medium ? "selected" : "")>Medium</!option>
                                                    <!option value="High" @(Model.Impact == IncidentImpact.High ? "selected" : "")>High</!option>
                                                </select>
                                            </div>
                                            <div class="flex-grow-1">
                                                <label class="form-label text-muted small">Urgency</label>
                                                <select name="urgency" class="form-select bg-dark text-white border-secondary form-select-sm">
                                                    <!option value="Low" @(Model.Urgency == IncidentUrgency.Low ? "selected" : "")>Low</!option>
                                                    <!option value="Medium" @(Model.Urgency == IncidentUrgency.Medium ? "selected" : "")>Medium</!option>
                                                    <!option value="High" @(Model.Urgency == IncidentUrgency.High ? "selected" : "")>High</!option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label text-muted small">Resolution Feedback</label>
                                            <textarea name="feedback" class="form-control bg-dark text-white border-secondary" rows="2" placeholder="Optional notes for the user or system..."></textarea>
                                        </div>
                                        <button type="submit" class="btn btn-secondary w-100 font-weight-semibold">
                                            <i class="bi bi-save me-1"></i> Save Changes
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <div class="alert alert-info text-dark small py-2 mb-3">
                                        Assigned to another analyst.
                                    </div>
                                }
                            }

                            <div class="d-flex gap-2">
                                <form asp-action="ApproveOrReject" method="post" class="flex-grow-1">
                                    <input type="hidden" name="draftId" value="@Model.Id" />
                                    <input type="hidden" name="approved" value="true" />
                                    <button type="submit" class="btn btn-success w-100 font-weight-semibold">
                                        <i class="bi bi-check-lg me-1"></i> Approve & Submit
                                    </button>
                                </form>

                                <form asp-action="ApproveOrReject" method="post" class="flex-grow-1">
                                    <input type="hidden" name="draftId" value="@Model.Id" />
                                    <input type="hidden" name="approved" value="false" />
                                    <button type="submit" class="btn btn-outline-danger w-100 font-weight-semibold">
                                        <i class="bi bi-x-lg me-1"></i> Reject Draft
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-2">
                                <i class="bi bi-lock-fill text-secondary fs-4 d-block mb-1"></i>
                                <span class="text-muted small">Decision finalized as <strong>@Model.ApprovalStatus</strong>.</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.ResolutionFeedback))
                            {
                                <div class="mt-3 p-3 rounded bg-dark border border-secondary text-info small">
                                    <strong>Resolution Feedback:</strong><br />
                                    @Model.ResolutionFeedback
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
