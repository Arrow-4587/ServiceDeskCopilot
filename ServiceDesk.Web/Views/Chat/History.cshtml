@{
    ViewData["Title"] = "Chat History";
    var historyItems = ViewBag.HistoryItems as IEnumerable<dynamic>;
    var totalSessions = historyItems?.Count() ?? 0;
}

<div class="dashboard-page w-100">
    <!-- Header Block aligned with Incidents Page Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 pb-2 border-bottom gap-3" style="border-color:var(--border-soft) !important;">
        <div>
            <h3 class="fw-bold mb-1" style="color:var(--text-heading);letter-spacing:-0.3px;">
                <i class="bi bi-clock-history text-primary me-2"></i> Chat History
            </h3>
            <p class="small mb-0" style="color:var(--text-muted);">
                Review past AI copilot conversations and audit request trails.
            </p>
        </div>
        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
            <a href="@Url.Action("Index", "Chat")" class="btn btn-sm btn-gradient rounded-3 px-3 py-2 fw-semibold">
                <i class="bi bi-chat-dots-fill me-1.5"></i> Open Full Copilot Chat
            </a>
        </div>
    </div>

    <div class="card status-card mb-4">
        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <h5 class="fw-bold mb-0 status-card-title">
                <i class="bi bi-chat-square-text me-2 text-primary"></i> Conversation Sessions
            </h5>
            <span class="badge rounded-pill px-3 py-1.5" style="background:var(--brand-blue-light, rgba(37,99,235,0.1));color:var(--brand-blue, #2563eb);border:1px solid var(--brand-blue, #2563eb);font-weight:600;font-size:0.8rem;">
                Total: @totalSessions Sessions
            </span>
        </div>
        <div class="card-body p-0">

            @if (historyItems != null && historyItems.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle small mb-0" data-paginate="10" style="color:var(--text-body);">
                        <thead style="background:var(--bg-surface-alt);border-bottom:1px solid var(--border-soft) !important;">
                            <tr>
                                <th class="ps-4 py-3" style="color:var(--text-heading);font-weight:600;">Date Started</th>
                                <th class="py-3" style="color:var(--text-heading);font-weight:600;">Initiator Role</th>
                                <th class="py-3" style="color:var(--text-heading);font-weight:600;">Messages</th>
                                <th class="py-3" style="color:var(--text-heading);font-weight:600;">Status</th>
                                <th class="pe-4 py-3 text-end" style="color:var(--text-heading);font-weight:600;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in historyItems)
                            {
                                var session = item.Session as ServiceDesk.Domain.Entities.ConversationSession;
                                var role = item.Role as string;
                                if (session == null) continue;

                                var roleStyle = role switch
                                {
                                    "Administrator" => "background:rgba(124,58,237,0.12);color:var(--accent-violet, #7c3aed);border:1px solid rgba(124,58,237,0.3);",
                                    "Manager" => "background:rgba(245,158,11,0.12);color:var(--warning, #d97706);border:1px solid rgba(245,158,11,0.3);",
                                    "Analyst" => "background:rgba(2,132,199,0.12);color:var(--accent-teal, #0284c7);border:1px solid rgba(2,132,199,0.3);",
                                    "Employee" => "background:rgba(37,99,235,0.12);color:var(--brand-blue, #2563eb);border:1px solid rgba(37,99,235,0.3);",
                                    _ => "background:var(--bg-surface-alt);color:var(--text-muted);border:1px solid var(--border-soft);"
                                };
                                
                                <tr style="border-bottom:1px solid var(--border-soft);">
                                    <td class="ps-4 text-nowrap">
                                        <div class="d-inline-flex align-items-center gap-1.5">
                                            <i class="bi bi-clock-history text-primary me-1" style="font-size:0.9rem;"></i>
                                            <span class="fw-semibold" style="color:var(--text-heading);font-size:0.85rem;">
                                                @session.StartedAt.ToLocalTime().ToString("MMM dd, yyyy")
                                            </span>
                                            <span class="font-monospace small ms-1" style="font-size:0.78rem;color:var(--text-muted) !important;">
                                                @session.StartedAt.ToLocalTime().ToString("hh:mm tt")
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill px-2.5 py-1" style="@roleStyle font-weight:600;">
                                            @role
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill px-2.5 py-1" style="background:rgba(37,99,235,0.12);color:var(--brand-blue,#2563eb);border:1px solid rgba(37,99,235,0.3);font-weight:600;">
                                            <i class="bi bi-chat-text me-1"></i>@(session.Messages?.Count ?? 0) msgs
                                        </span>
                                    </td>
                                    <td>
                                        @if (session.IsActive)
                                        {
                                            <span class="badge rounded-pill status-badge-operational px-2.5 py-1" style="font-weight:600;">
                                                <i class="bi bi-circle-fill me-1" style="font-size: 0.45rem;"></i>Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle px-2.5 py-1" style="font-weight:600;">
                                                Closed
                                            </span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        <a href="@Url.Action("Index", "Chat", new { conversationId = session.Id })" class="btn btn-sm btn-outline-primary rounded-3 px-3 py-1">
                                            <i class="bi bi-eye-fill me-1"></i> View Chat
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-chat-square-dots text-muted fs-1 mb-3 d-block opacity-50"></i>
                    <h5 class="fw-bold" style="color:var(--text-heading);">No chat history found</h5>
                    <p class="small max-w-md mx-auto" style="color:var(--text-muted);">
                        You haven't started any AI Copilot conversations yet. Click below to begin a new session.
                    </p>
                    <a href="@Url.Action("Index", "Chat")" class="btn btn-sm btn-primary mt-2">
                        Start First Conversation
                    </a>
                </div>
            }

        </div>
    </div>
</div>


