@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="container text-center py-5">
    <div class="card border-danger shadow mx-auto" style="max-width: 500px;">
        <div class="card-body p-4">
            <h1 class="text-danger display-4"><i class="bi bi-shield-slash"></i></h1>
            <h3 class="card-title text-danger">Access Denied</h3>
            <p class="card-text text-muted">You do not have the required permissions or role to access this enterprise resource.</p>
            <a href="/" class="btn btn-outline-secondary mt-3"><i class="bi bi-house me-1"></i>Return to Dashboard</a>
        </div>
    </div>
</div>
