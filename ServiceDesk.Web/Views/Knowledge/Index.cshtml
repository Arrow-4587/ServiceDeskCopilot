@model IReadOnlyList<ServiceDesk.Application.DTOs.Knowledge.KnowledgeDocumentDto>
@{
    ViewData["Title"] = "Knowledge Base Repository";
}

<div class="dashboard-page w-100">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 pb-2 border-bottom" style="border-color:var(--border-soft) !important;">
        <div>
            <h3 class="fw-bold mb-1" style="color:var(--text-heading);letter-spacing:-0.3px;">
                <i class="bi bi-journal-bookmark-fill text-primary me-2"></i> Knowledge Base Repository
            </h3>
            <p class="text-muted small mb-0">
                Official IT documentation, operational policies, and self-service resolution guides powered by RAG.
            </p>
        </div>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@ViewBag.ErrorMessage</div>
        </div>
    }

    @await Html.PartialAsync("_KnowledgeBasePartial", Model)
</div>

