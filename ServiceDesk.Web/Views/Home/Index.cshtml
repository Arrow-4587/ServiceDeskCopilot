@model ServiceDesk.Web.Models.HomeViewModel
@{
    ViewData["Title"] = "Overview Command Center";
    var username = Model.Username;
    var userRole = Model.UserRole;
    var isAdmin = userRole.Equals("Administrator", StringComparison.OrdinalIgnoreCase);
    var isManager = userRole.Equals("Manager", StringComparison.OrdinalIgnoreCase);
    var isAnalyst = userRole.Equals("Analyst", StringComparison.OrdinalIgnoreCase);
    var isEmployee = !isAdmin && !isManager && !isAnalyst;
}

<div class="dashboard-page">
    
    <!-- ─── ROLE-SPECIFIC COMMAND CENTER HEADER ─── -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom" style="border-color:var(--border) !important;">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge rounded-pill px-3 py-1" style="background:var(--accent-muted);color:var(--accent);border:1px solid var(--border-soft);font-size:0.75rem;font-weight:700;">
                    <i class="bi bi-person-badge me-1"></i>@userRole Command Center
                </span>
            </div>
            <h2 class="fw-bold mb-0" style="color:var(--text-primary);letter-spacing:-0.4px;">
                Welcome back, @username
            </h2>
            <p class="text-muted small mb-0 mt-1">
                Here is your operational snapshot for today.
            </p>
        </div>

        <div class="d-flex align-items-center gap-2 mt-3 mt-md-0">
            <button type="button" id="btnHomeReportIssue" class="btn btn-sm btn-outline-primary rounded-3 px-3 py-2 fw-semibold">
                <i class="bi bi-plus-circle me-1"></i> Report an Issue
            </button>
            <button type="button" id="btnLaunchCopilotHome" class="btn btn-sm btn-gradient rounded-3 px-3 py-2 fw-semibold">
                <i class="bi bi-stars me-1"></i> Ask Copilot
            </button>
        </div>
    </div>

    <!-- ─── ROLE-SPECIFIC STAT CARDS ─── -->
    <div class="stat-cards">
        @if (isAdmin)
        {
            <div class="stat-card">
                <div class="stat-card-accent" style="background:var(--brand-blue);"></div>
                <div class="stat-card-icon" style="background:var(--brand-blue-light);color:var(--brand-blue);">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="stat-card-body">
                    <div class="stat-label">Registered Users</div>
                    <div class="stat-value">@Model.RegisteredUsers.Count</div>
                    <a asp-controller="Admin" asp-action="Index" class="stat-link">Manage Users &rarr;</a>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-card-accent" style="background:var(--accent-violet);"></div>
                <div class="stat-card-icon" style="background:rgba(124,58,237,0.12);color:var(--accent-violet);">
                    <i class="bi bi-ticket-detailed-fill"></i>
                </div>
                <div class="stat-card-body">
                    <div class="stat-label">Total Tickets</div>
                    <div class="stat-value">@Model.EmployeeTicketStats.Values.Sum()</div>
                    <a asp-controller="Incident" asp-action="Index" class="stat-link">View All Tickets &rarr;</a>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-card-accent" style="background:var(--accent-teal);"></div>
                <div class="stat-card-icon" style="background:rgba(2,132,199,0.12);color:var(--accent-teal);">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div class="stat-card-body">
                    <div class="stat-label">Audit Logs</div>
                    <div class="stat-value">@Model.AuditLogs.Count</div>
                    <a asp-controller="Admin" asp-action="Index" class="stat-link">Audit Trail &rarr;</a>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-card-accent" style="background:var(--success);"></div>
                <div class="stat-card-icon" style="background:rgba(16,185,129,0.12);color:var(--success);">
                    <i class="bi bi-hdd-network-fill"></i>
                </div>
                <div class="stat-card-body">
                    <div class="stat-label">System Health</div>
                    <div class="stat-value">100%</div>
                    <a asp-controller="Status" asp-action="Index" class="stat-link">Service Health &rarr;</a>
                </div>
            </div>
        }
        else if (isManager)
        {
            <div class="stat-card">
                <div class="stat-card-accent" style="background:var(--brand-blue);"></div>
                <div class="stat-card-icon" style="background:var(--brand-blue-light);color:var(--brand-blue);">
                    <i class="bi bi-bar-chart-line-fill"></i>
                </div>
                <div class="stat-card-body">
                    <div class="stat-label">Incident Volume</div>
                    <div class="stat-value">@Model.UserTickets.Count</div>
                    <a asp-controller="Manager" asp-action="Index" class="stat-link">Manager Analytics &rarr;</a>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-card-accent" style="background:var(--warning);"></div>
                <div class="stat-card-icon" style="background:rgba(217,119,6,0.12);color:var(--warning);">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div class="stat-card-body">
                    <div class="stat-label">Active Conversations</div>
                    <div class="stat-value">@Model.UserChatHistory.Count</div>
                    <a asp-controller="Chat" asp-action="History" class="stat-link">Chat History &rarr;</a>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-card-accent" style="background:var(--accent-violet);"></div>
                <div class="stat-card-icon" style="background:rgba(124,58,237,0.12);color:var(--accent-violet);">
                    <i class="bi bi-cpu-fill"></i>
                </div>
                <div class="stat-card-body">
                    <div class="stat-label">AI Accuracy</div>
                    <div class="stat-value">97.2%</div>
                    <a asp-controller="Manager" asp-action="Index" class="stat-link">Agent Metrics &rarr;</a>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-card-accent" style="background:var(--success);"></div>
                <div class="stat-card-icon" style="background:rgba(16,185,129,0.12);color:var(--success);">
                    <i class="bi bi-check-all"></i>
                </div>
                <div class="stat-card-body">
                    <div class="stat-label">Service Status</div>
                    <div class="stat-value">Healthy</div>
                    <a asp-controller="Status" asp-action="Index" class="stat-link">Service Health &rarr;</a>
                </div>
            </div>
        }
        else if (isAnalyst)
        {
            <div class="stat-card">
                <div class="stat-card-accent" style="background:var(--brand-blue);"></div>
                <div class="stat-card-icon" style="background:var(--brand-blue-light);color:var(--brand-blue);">
                    <i class="bi bi-inbox-fill"></i>
                </div>
                <div class="stat-card-body">
                    <div class="stat-label">Triage Queue</div>
                    <div class="stat-value">@Model.AnalystMetrics.TriageQueueCount</div>
                    <a asp-controller="Incident" asp-action="Index" class="stat-link">Incident Queue &rarr;</a>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-card-accent" style="background:var(--warning);"></div>
                <div class="stat-card-icon" style="background:rgba(217,119,6,0.12);color:var(--warning);">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div class="stat-card-body">
                    <div class="stat-label">Pending Approval</div>
                    <div class="stat-value">@Model.AnalystMetrics.PendingApprovalCount</div>
                    <a asp-controller="Incident" asp-action="Index" class="stat-link">Review Tickets &rarr;</a>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-card-accent" style="background:var(--accent-violet);"></div>
                <div class="stat-card-icon" style="background:rgba(124,58,237,0.12);color:var(--accent-violet);">
                    <i class="bi bi-chat-left-text-fill"></i>
                </div>
                <div class="stat-card-body">
                    <div class="stat-label">End-User Sessions</div>
                    <div class="stat-value">@Model.AnalystMetrics.EndUserSessionCount</div>
                    <a asp-controller="Chat" asp-action="History" class="stat-link">Chat History &rarr;</a>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-card-accent" style="background:var(--success);"></div>
                <div class="stat-card-icon" style="background:rgba(16,185,129,0.12);color:var(--success);">
                    <i class="bi bi-journal-check"></i>
                </div>
                <div class="stat-card-body">
                    <div class="stat-label">Knowledge Base</div>
                    <div class="stat-value">@Model.AnalystMetrics.KnowledgeBaseCount</div>
                    <a asp-controller="Knowledge" asp-action="Index" class="stat-link">Browse KB &rarr;</a>
                </div>
            </div>
        }
        else // Employee
        {
            <div class="stat-card">
                <div class="stat-card-accent" style="background:var(--brand-blue);"></div>
                <div class="stat-card-icon" style="background:var(--brand-blue-light);color:var(--brand-blue);">
                    <i class="bi bi-ticket-perforated-fill"></i>
                </div>
                <div class="stat-card-body">
                    <div class="stat-label">My Incidents</div>
                    <div class="stat-value">@Model.UserTickets.Count</div>
                    <a asp-controller="Incident" asp-action="Index" class="stat-link">View My Incidents &rarr;</a>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-card-accent" style="background:var(--accent-violet);"></div>
                <div class="stat-card-icon" style="background:rgba(124,58,237,0.12);color:var(--accent-violet);">
                    <i class="bi bi-chat-dots-fill"></i>
                </div>
                <div class="stat-card-body">
                    <div class="stat-label">Copilot Chats</div>
                    <div class="stat-value">@Model.UserChatHistory.Count</div>
                    <a asp-controller="Chat" asp-action="History" class="stat-link">Chat History &rarr;</a>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-card-accent" style="background:var(--accent-teal);"></div>
                <div class="stat-card-icon" style="background:rgba(2,132,199,0.12);color:var(--accent-teal);">
                    <i class="bi bi-journal-bookmark-fill"></i>
                </div>
                <div class="stat-card-body">
                    <div class="stat-label">KB Guides</div>
                    <div class="stat-value">@Model.KnowledgeDocuments.Count</div>
                    <a asp-controller="Knowledge" asp-action="Index" class="stat-link">Search Guides &rarr;</a>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-card-accent" style="background:var(--success);"></div>
                <div class="stat-card-icon" style="background:rgba(16,185,129,0.12);color:var(--success);">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div class="stat-card-body">
                    <div class="stat-label">Service Health</div>
                    <div class="stat-value">Operational</div>
                    <a asp-controller="Status" asp-action="Index" class="stat-link">Check Status &rarr;</a>
                </div>
            </div>
        }
    </div>

    <!-- ─── ROLE-SPECIFIC SNAPSHOT PANELS ─── -->
    <div class="row g-4 mb-4">
        
        <!-- Left Panel: Recent Incidents Preview -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background:var(--bg-surface); border:1px solid var(--border-soft) !important;">
                <div class="card-header bg-transparent py-3 px-4 d-flex align-items-center justify-content-between border-bottom" style="border-color:var(--border-soft) !important;">
                    <h5 class="mb-0 fw-bold" style="color:var(--text-heading);font-size:1.05rem;">
                        <i class="bi bi-lightning-charge-fill me-2 text-warning"></i>
                        @(isAnalyst ? "Recent Triage Queue" : isAdmin ? "Employee Ticket Activity" : "My Recent Incidents")
                    </h5>
                    <a asp-controller="Incident" asp-action="Index" class="btn btn-sm btn-link p-0 text-decoration-none fw-semibold" style="font-size:0.83rem;color:var(--brand-blue);">
                        View All &rarr;
                    </a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size:0.875rem;">
                        <thead style="background:var(--bg-surface-alt);color:var(--text-muted);font-size:0.75rem;text-transform:uppercase;">
                            <tr>
                                <th class="ps-4">Title</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var ticketsToShow = isAnalyst ? Model.AllTickets.Take(5) : isAdmin ? Model.AllTickets.Take(5) : Model.UserTickets.Take(5);
                            }
                            @foreach (var ticket in ticketsToShow)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-truncate" style="max-width:260px;color:var(--text-heading);">
                                        @ticket.Title
                                    </td>
                                    <td>
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill">
                                            @ticket.ComputedPriority
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill">
                                            @ticket.Status
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a href="@Url.Action("Details", "Incident", new { id = ticket.Id })" class="btn btn-sm btn-outline-primary rounded-3 py-1 px-3">
                                            Details
                                        </a>
                                    </td>
                                </tr>
                            }
                            @if (!ticketsToShow.Any())
                            {
                                <tr>
                                    <td colspan="4" class="ps-4 text-muted py-4 text-center">
                                        <i class="bi bi-inbox fs-4 d-block mb-1 opacity-50"></i>
                                        No recent incidents found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right Panel: Recent Conversations Preview -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background:var(--bg-surface); border:1px solid var(--border-soft) !important;">
                <div class="card-header bg-transparent py-3 px-4 d-flex align-items-center justify-content-between border-bottom" style="border-color:var(--border-soft) !important;">
                    <h5 class="mb-0 fw-bold" style="color:var(--text-heading);font-size:1.05rem;">
                        <i class="bi bi-chat-left-dots-fill me-2" style="color:var(--accent-violet);"></i>
                        Recent Conversations
                    </h5>
                    <a asp-controller="Chat" asp-action="History" class="btn btn-sm btn-link p-0 text-decoration-none fw-semibold" style="font-size:0.83rem;color:var(--brand-blue);">
                        History &rarr;
                    </a>
                </div>
                <div class="list-group list-group-flush">
                    @{
                        var chatsToShow = isAnalyst ? Model.AllChatHistory.Take(5) : Model.UserChatHistory.Take(5);
                    }
                    @foreach (var chat in chatsToShow)
                    {
                        <div class="list-group-item bg-transparent px-4 py-3 d-flex align-items-center justify-content-between gap-2 border-bottom" style="border-color:var(--border-soft) !important;">
                            <div class="min-w-0">
                                <div class="fw-semibold text-truncate small mb-1" style="color:var(--text-heading);">
                                    <i class="bi bi-chat-text me-1 text-primary"></i> Copilot Session
                                </div>
                                <div class="text-muted small" style="font-size:0.75rem;">
                                    <i class="bi bi-clock me-1"></i>@chat.StartedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 px-3 py-1 btn-open-copilot-session" data-session-id="@chat.Id">
                                Open
                            </button>
                        </div>
                    }
                    @if (!chatsToShow.Any())
                    {
                        <div class="p-4 text-center text-muted small">
                            <i class="bi bi-chat-square-dots fs-4 d-block mb-1 opacity-50"></i>
                            No recent conversations found.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ─── KNOWLEDGE BASE SHORTCUTS ─── -->
    <div class="mt-2">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="fw-bold mb-0" style="color:var(--text-heading);font-size:1.1rem;">
                <i class="bi bi-journal-bookmark-fill me-2" style="color:var(--accent-violet);"></i>Knowledge Base Shortcuts
            </h5>
            <a asp-controller="Knowledge" asp-action="Index" class="btn btn-sm btn-link p-0 text-decoration-none fw-semibold" style="font-size:0.85rem;color:var(--brand-blue);">
                Browse Knowledge Base &rarr;
            </a>
        </div>
        @await Html.PartialAsync("_KnowledgeBasePartial", Model.KnowledgeDocuments)
    </div>

</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const btnAskCopilot = document.getElementById('btnLaunchCopilotHome');
        const btnReportIssue = document.getElementById('btnHomeReportIssue');

        if (btnAskCopilot) {
            btnAskCopilot.addEventListener('click', function() {
                if (typeof window.submitCopilotMessage === 'function') {
                    window.submitCopilotMessage('');
                }
            });
        }

        if (btnReportIssue) {
            btnReportIssue.addEventListener('click', function() {
                const title = prompt("Enter a title for your issue (minimum 5 characters):");
                if (!title) return;
                const desc = prompt("Enter details about your issue (minimum 15 characters):");
                if (!desc) return;

                fetch('/Incident/CreateDraftManual', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title: title, description: desc })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.draftId) {
                        window.location.href = '/Incident/Details/' + data.draftId;
                    } else {
                        alert('Failed to generate manual draft.');
                    }
                })
                .catch(err => {
                    alert('An error occurred while generating the draft.');
                });
            });
        }

        document.querySelectorAll('.btn-open-copilot-session').forEach(btn => {
            btn.addEventListener('click', function() {
                const sessId = this.getAttribute('data-session-id');
                const widgetConvId = document.getElementById('widgetConversationId');
                if (widgetConvId) widgetConvId.value = sessId;
                if (typeof window.submitCopilotMessage === 'function') {
                    window.submitCopilotMessage('');
                }
            });
        });
    });
</script>
}
