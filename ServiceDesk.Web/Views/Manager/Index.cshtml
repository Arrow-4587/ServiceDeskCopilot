@using ServiceDesk.Domain.Entities
@{
    ViewData["Title"] = "Manager Dashboard";
    var agents = ViewBag.AgentMetrics as IEnumerable<ManagerAgentMetric> ?? Enumerable.Empty<ManagerAgentMetric>();
    var auditLogs = ViewBag.AuditLogs as List<AuditLog> ?? new();
    var totalRequests = (int)(ViewBag.TotalRequests ?? 0);
    var totalTokens = (int)(ViewBag.TotalTokens ?? 0);
    var avgSuccess = ViewBag.AvgSuccess?.ToString() ?? "100.0";
    var username = User.Identity?.Name ?? "Manager";
}

<div class="dashboard-page w-100">

    @* ─── Page Header ───────────────────────────────────────────── *@
    <div class="page-header" style="margin-bottom:28px;">
        <h1 style="font-size:20px;font-weight:700;color:var(--text-primary);margin-bottom:4px;">
            <i class="bi bi-speedometer2 me-2" style="color:var(--accent);"></i>Manager Dashboard
        </h1>
        <p style="font-size:13px;color:var(--text-secondary);">
            Welcome back, <strong style="color:var(--text-primary);">@username</strong> &nbsp;·&nbsp; AI agent telemetry &amp; operational metrics.
        </p>
    </div>

    @* ─── Summary Stat Cards ───────────────────────────────────────────── *@
    <div class="stat-cards" style="margin-bottom:24px;">
        <div class="stat-card">
            <div class="stat-card-accent" style="background:var(--accent);"></div>
            <div class="stat-card-icon" style="background:var(--accent-muted);">
                <i class="bi bi-activity" style="color:var(--accent);font-size:18px;"></i>
            </div>
            <div class="stat-card-body">
                <div class="stat-label">Total AI Requests</div>
                <div class="stat-value">@totalRequests</div>
                <span class="stat-link">Across all 3 agents</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-accent" style="background:#7c3aed;"></div>
            <div class="stat-card-icon" style="background:rgba(124,58,237,0.12);">
                <i class="bi bi-cpu" style="color:#7c3aed;font-size:18px;"></i>
            </div>
            <div class="stat-card-body">
                <div class="stat-label">Total Tokens Used</div>
                <div class="stat-value">@(totalTokens.ToString("N0"))</div>
                <span class="stat-link">Azure OpenAI consumption</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-accent" style="background:#059669;"></div>
            <div class="stat-card-icon" style="background:rgba(5,150,105,0.12);">
                <i class="bi bi-check2-circle" style="color:#059669;font-size:18px;"></i>
            </div>
            <div class="stat-card-body">
                <div class="stat-label">Avg. Success Rate</div>
                <div class="stat-value">@avgSuccess%</div>
                <span class="stat-link">Agent reliability score</span>
            </div>
        </div>
    </div>

    @* ─── AI METRICS SECTION ─────────────────────────────────────────── *@
    <div>

            @* Agent Cards Grid *@
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:24px;">
                @foreach (var agent in agents)
                {
                    <div class="card" style="background:var(--bg-surface);border:1px solid var(--border);border-radius:14px;overflow:hidden;transition:border-color 0.2s;" onmouseover="this.style.borderColor='@agent.Color'" onmouseout="this.style.borderColor='var(--border)'">
                        <div style="height:3px;background:@agent.Color;"></div>
                        <div style="padding:20px 22px;">
                            <div style="display:flex;align-items:center;gap:12px;margin-bottom:18px;">
                                <div style="width:42px;height:42px;border-radius:10px;background:@agent.ColorMuted;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                    <i class="bi @agent.Icon" style="font-size:18px;color:@agent.Color;"></i>
                                </div>
                                <div>
                                    <div style="font-size:13px;font-weight:700;color:var(--text-primary);">@agent.Name</div>
                                    <div style="font-size:11px;color:var(--text-secondary);margin-top:2px;">Azure OpenAI · GPT-4o</div>
                                </div>
                            </div>

                            @* Metrics Grid *@
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px;">
                                <div style="background:var(--bg-page);border-radius:8px;padding:10px 12px;">
                                    <div style="font-size:10px;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">Requests</div>
                                    <div style="font-size:22px;font-weight:700;color:var(--text-primary);">@agent.Requests</div>
                                </div>
                                <div style="background:var(--bg-page);border-radius:8px;padding:10px 12px;">
                                    <div style="font-size:10px;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">Tokens</div>
                                    <div style="font-size:22px;font-weight:700;color:var(--text-primary);">@(agent.TotalTokens.ToString("N0"))</div>
                                </div>
                                <div style="background:var(--bg-page);border-radius:8px;padding:10px 12px;">
                                    <div style="font-size:10px;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">Avg Latency</div>
                                    <div style="font-size:22px;font-weight:700;color:var(--text-primary);">@agent.AvgLatencyMs<span style="font-size:12px;font-weight:400;color:var(--text-secondary);">ms</span></div>
                                </div>
                                <div style="background:var(--bg-page);border-radius:8px;padding:10px 12px;">
                                    <div style="font-size:10px;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">Success Rate</div>
                                    <div style="font-size:22px;font-weight:700;color:#059669;">@agent.SuccessRate.ToString("0.0")<span style="font-size:12px;font-weight:400;color:var(--text-secondary);">%</span></div>
                                </div>
                            </div>

                            @* Success Rate Bar *@
                            <div>
                                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:5px;">
                                    <span style="font-size:11px;color:var(--text-secondary);">Success Rate</span>
                                    <span style="font-size:11px;font-weight:600;color:#059669;">@agent.SuccessRate.ToString("0.0")%</span>
                                </div>
                                <div style="height:5px;background:var(--bg-page);border-radius:999px;overflow:hidden;">
                                    <div style="height:100%;width:@agent.SuccessRate.ToString("0.0")%;background:linear-gradient(90deg,@agent.Color,#059669);border-radius:999px;transition:width 0.6s ease;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @* Requests Timeline Table (from Audit) *@
            <div class="card" style="background:var(--bg-surface);border:1px solid var(--border);border-radius:14px;overflow:hidden;">
                <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--border);">
                    <span class="card-title" style="font-size:13px;font-weight:600;color:var(--text-primary);">
                        <i class="bi bi-list-check me-2" style="color:var(--accent);"></i>Recent AI Activity Log
                    </span>
                    <span class="card-badge" style="font-size:11px;font-weight:600;padding:3px 8px;border-radius:999px;background:var(--accent-muted);color:var(--accent);border:1px solid rgba(43,92,230,0.25);">
                        @auditLogs.Count Events
                    </span>
                </div>
                <div>
                    <table class="table align-middle mb-0" data-paginate="10" style="width:100%;border-collapse:collapse;--bs-table-bg:var(--bg-surface);--bs-table-color:var(--text-body);">
                        <thead>
                            <tr>
                                <th style="font-size:10.5px;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.5px;padding:10px 18px;text-align:left;background:rgba(255,255,255,0.02);">Timestamp</th>
                                <th style="font-size:10.5px;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.5px;padding:10px 18px;text-align:left;background:rgba(255,255,255,0.02);">User</th>
                                <th style="font-size:10.5px;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.5px;padding:10px 18px;text-align:left;background:rgba(255,255,255,0.02);">Role</th>
                                <th style="font-size:10.5px;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.5px;padding:10px 18px;text-align:left;background:rgba(255,255,255,0.02);">Action</th>
                                <th style="font-size:10.5px;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.5px;padding:10px 18px;text-align:left;background:rgba(255,255,255,0.02);">Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (auditLogs.Any())
                            {
                                @foreach (var log in auditLogs)
                                {
                                    var actionColor = log.Action switch
                                    {
                                        "ChatQuery" => "#3b82f6",
                                        "ApproveIncident" => "#059669",
                                        "RejectIncident" => "#ef4444",
                                        "IncidentCreated" => "#f59e0b",
                                        "UserLogin" => "#7c3aed",
                                        _ => "var(--text-secondary)"
                                    };
                                    <tr style="border-top:1px solid var(--border);" onmouseover="this.style.background='var(--bg-hover)'" onmouseout="this.style.background=''">
                                        <td style="font-size:12px;color:var(--text-secondary);padding:10px 18px;white-space:nowrap;">@log.Timestamp.ToLocalTime().ToString("MM/dd HH:mm")</td>
                                        <td style="font-size:13px;font-weight:500;color:var(--text-primary);padding:10px 18px;">@log.UserId</td>
                                        <td style="padding:10px 18px;"><span style="font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;background:var(--accent-muted);color:var(--accent);">@log.UserRole</span></td>
                                        <td style="padding:10px 18px;"><span style="font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;background:rgba(0,0,0,0.08);color:@actionColor;">@log.Action</span></td>
                                        <td style="font-size:12px;color:var(--text-secondary);padding:10px 18px;max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@log.Details">@log.Details</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr class="no-paginate"><td colspan="5" style="text-align:center;padding:32px;color:var(--text-secondary);font-size:13px;"><i class="bi bi-info-circle me-2"></i>No activity logs found.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>@* /dashboard-page *@

