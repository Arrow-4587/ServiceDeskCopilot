@model ServiceDesk.Web.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "User Login";
    Layout = "_LoginLayout";
}

<div class="login-container">
    <div class="login-card">
        <h1 class="login-title">USER LOGIN</h1>

        <form asp-action="Login" method="post" class="login-form">
            <input type="hidden" asp-for="ReturnUrl" />
            
            <div asp-validation-summary="ModelOnly" class="login-validation-summary" role="alert"></div>

            <div class="login-field-wrapper">
                <div class="login-input-group">
                    <div class="login-icon-badge login-icon-badge-left">
                        <i class="bi bi-person text-dark fs-5" aria-hidden="true"></i>
                    </div>
                    <input asp-for="Email" class="login-input" placeholder="Username" autocomplete="username" />
                </div>
                <span asp-validation-for="Email" class="login-field-error"></span>
            </div>

            <div class="login-field-wrapper">
                <div class="login-input-group">
                    <input asp-for="Password" id="passwordInput" type="password" class="login-input login-input-password" placeholder="Password" autocomplete="current-password" />
                    <button type="button" class="login-icon-badge login-icon-badge-right login-pwd-btn" id="togglePasswordBtn" title="Show password" aria-label="Show password">
                        <i class="bi bi-eye-fill text-dark fs-5" id="togglePasswordIcon" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="login-field-error"></span>
            </div>

            <div class="login-remember-wrapper">
                <label class="login-remember-label" for="rememberMeCheck">
                    <input asp-for="RememberMe" class="login-remember-checkbox" type="checkbox" id="rememberMeCheck" />
                    <span class="login-remember-custom-check">
                        <i class="bi bi-check-lg"></i>
                    </span>
                    <span class="login-remember-text">Remember Me</span>
                </label>
            </div>

            <button type="submit" class="login-submit-btn">
                LOGIN
            </button>
        </form>
    </div>
</div>
