@{
    ViewData["Title"] = "Chat History";
    var historyItems = ViewBag.HistoryItems as IEnumerable<dynamic>;
}

<div class="mb-4">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
            <h3 class="fw-bold mb-1">Chat History</h3>
            <p class="text-muted mb-0 small">Review past AI copilot conversations and audit request trails.</p>
        </div>
        <div>
            <a href="@Url.Action("Index", "Chat")" class="btn btn-primary font-weight-semibold shadow-sm">
                <i class="bi bi-chat-dots-fill me-1.5"></i> Open Full Copilot Chat
            </a>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
        <div class="d-flex align-items-center justify-content-between">
            <h5 class="fw-bold mb-0 text-primary"><i class="bi bi-clock-history me-2"></i> Conversation Sessions</h5>
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2.5 py-1">
                Total: @(historyItems?.Count() ?? 0) Sessions
            </span>
        </div>
    </div>
    <div class="card-body p-4">

        @if (historyItems != null && historyItems.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" data-paginate="10">
                    <thead class="table-light">
                        <tr>
                            <th>Date Started</th>
                            <th>Initiator Role</th>
                            <th>Messages</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in historyItems)
                        {
                            var session = item.Session as ServiceDesk.Domain.Entities.ConversationSession;
                            var role = item.Role as string;
                            if (session == null) continue;
                            
                            <tr>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="fw-medium text-body">@session.StartedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                                        <span class="text-muted small">@session.StartedAt.ToLocalTime().ToString("HH:mm")</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2.5 py-1">@role</span>
                                </td>
                                <td>
                                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 rounded-pill px-2.5 py-1">@(session.Messages?.Count ?? 0) msgs</span>
                                </td>
                                <td>
                                    @if (session.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2.5 py-1">
                                            <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill px-2.5 py-1">
                                            Closed
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a href="@Url.Action("Index", "Chat", new { conversationId = session.Id })" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="bi bi-eye me-1"></i> View Chat
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-chat-square-dots text-muted fs-1 mb-3 d-block opacity-50"></i>
                <h5 class="fw-bold">No chat history found</h5>
                <p class="text-muted small max-w-md mx-auto">
                    You haven't started any AI Copilot conversations yet. Click below to begin a new session.
                </p>
                <a href="@Url.Action("Index", "Chat")" class="btn btn-sm btn-primary">
                    Start First Conversation
                </a>
            </div>
        }

    </div>
</div>

