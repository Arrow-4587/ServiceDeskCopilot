@model IReadOnlyList<ServiceDesk.Application.DTOs.Knowledge.KnowledgeDocumentDto>
@{
    ViewData["Title"] = "Knowledge Base Repository";
}

<div class="mb-4">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
            <h3 class="fw-bold mb-1">Knowledge Base Repository</h3>
            <p class="text-muted mb-0 small">Official IT documentation, operational policies, and self-service resolution guides powered by RAG.</p>
        </div>
    </div>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
        <div>@ViewBag.ErrorMessage</div>
    </div>
}

@await Html.PartialAsync("_KnowledgeBasePartial", Model)

